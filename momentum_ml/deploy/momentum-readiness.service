[Unit]
Description=Momentum forward shadow readiness scorecard
After=momentum-small13-shadow.service momentum-challenger.service

[Service]
Type=oneshot
User=hannesb
WorkingDirectory=/opt/momentum/momentum_ml
Environment=MOMENTUM_HOME=/opt/momentum/momentum_ml
ExecStartPre=/opt/momentum/venv/bin/python /opt/momentum/momentum_ml/regime_accuracy_audit.py
ExecStartPre=/opt/momentum/venv/bin/python /opt/momentum/momentum_ml/point_in_time_registry.py
ExecStart=/opt/momentum/venv/bin/python /opt/momentum/momentum_ml/momentum_readiness.py
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/opt/momentum/momentum_ml/results
