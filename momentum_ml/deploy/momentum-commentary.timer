[Unit]
Description=Kör momentum-commentary.service varje måndag

[Timer]
# Måndag kl 04:00 - EFTER både nattträningen (02:00) och den narrativa
# rapporten (03:30), så veckans kommentar kan citera båda.
OnCalendar=Mon *-*-* 04:00:00
Persistent=true
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
